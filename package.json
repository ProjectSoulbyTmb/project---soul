{
  "name": "project-soul-studios",
  "version": "0.16.0",
  "description": "Project Soul Studios privacy-focused desktop assistant and media workspace.",
  "author": "Tyler Michael Bosworth, inventor and creator of Project Soul Studios",
  "license": "SEE LICENSE IN LICENSE",
  "copyright": "Copyright (c) 2026 Tyler Michael Bosworth. All rights reserved.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProjectSoulbyTmb/project---soul.git"
  },
  "main": "src/electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke.js",
    "release:configure": "node scripts/configure-release-channel.js",
    "release:manifest": "node scripts/create-update-manifest.js",
    "release:evidence": "node scripts/create-release-evidence.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist": "npm run dist:win",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:mac:x64": "electron-packager . 'Project Soul' --platform=darwin --arch=x64 --out=dist-mac --overwrite --asar --prune=true",
    "dist:mac:arm64": "electron-packager . 'Project Soul' --platform=darwin --arch=arm64 --out=dist-mac --overwrite --asar --prune=true",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "25.1.8",
    "@electron/packager": "18.3.6"
  },
  "build": {
    "appId": "org.projectsoul.desktop",
    "productName": "Project Soul Studios",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Project-Soul-Studios-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Project-Soul-Studios-${version}-Windows-${arch}-Portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "Project-Soul-${version}-Linux-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
