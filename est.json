{
  "manifest_version": 1,
  "id": "com.soul.github-tracker",
  "name": "GitHub Tracker",
  "version": "1.0.0",
  "description": "Track GitHub repositories, PRs, issues, and notifications",
  "author": "Soul Consciousness Studios",
  "license": "LicenseRef-Eidovara-Source-Available-1.0",
  "keywords": ["github", "git", "tracker", "pr", "issues", "notifications"],
  "homepage": "https://github.com/ProjectSoulbyTmb/eidovara-github-tracker",
  "repository": "https://github.com/ProjectSoulbyTmb/eidovara-github-tracker",
  "funding": "https://github.com/sponsors/ProjectSoulbyTmb",
  "permissions": {
    "memory": true,
    "network": ["api.github.com"],
    "filesystem": [],
    "shell": [],
    "notifications": true,
    "clipboard": "read",
    "idle": false,
    "power": false,
    "idleDetection": false
  },
  "entrypoints": {
    "main": "src/index.js",
    "commands": [
      {
        "id": "github-tracker.watch",
        "name": "Watch Repository",
        "description": "Start watching a GitHub repository",
        "shortcut": "Ctrl+Shift+G",
        "category": "github",
        "action": "watch",
        "params": [
          {
            "name": "repo",
            "type": "string",
            "description": "Repository in owner/repo format",
            "required": true,
            "validation": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
          },
          {
            "name": "events",
            "type": "select",
            "description": "Events to track",
            "required": true,
            "default": "all",
            "options": [
              { "value": "all", "label": "All Events" },
              { "value": "prs", "label": "Pull Requests Only" },
              { "value": "issues", "label": "Issues Only" },
              { "value": "releases", "label": "Releases Only" },
              { "value": "workflows", "label": "Workflow Runs" }
            ]
          },
          {
            "name": "notify",
            "type": "boolean",
            "description": "Show desktop notifications",
            "required": false,
            "default": true
          }
        ]
      },
      {
        "id": "github-tracker.unwatch",
        "name": "Unwatch Repository",
        "description": "Stop watching a repository",
        "shortcut": "Ctrl+Shift+U",
        "category": "github",
        "action": "unwatch",
        "params": [
          {
            "name": "repo",
            "type": "string",
            "description": "Repository in owner/repo format",
            "required": true,
            "validation": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
          }
        ]
      },
      {
        "id": "github-tracker.list",
        "name": "List Watched Repos",
        "description": "List all watched repositories",
        "shortcut": "Ctrl+Shift+L",
        "category": "github",
        "action": "list",
        "params": []
      },
      {
        "id": "github-tracker.pr",
        "name": "Open PR",
        "description": "Open a pull request in browser",
        "shortcut": "Ctrl+Shift+P",
        "category": "github",
        "action": "open-pr",
        "params": [
          {
            "name": "repo",
            "type": "string",
            "description": "Repository in owner/repo format",
            "required": true,
            "validation": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
          },
          {
            "name": "number",
            "type": "number",
            "description": "PR number",
            "required": true
          }
        ]
      },
      {
        "id": "github-tracker.configure",
        "name": "Configure GitHub",
        "description": "Configure GitHub token and settings",
        "shortcut": "Ctrl+Shift+Alt+G",
        "category": "settings",
        "action": "configure",
        "params": [
          {
            "name": "token",
            "type": "string",
            "description": "GitHub Personal Access Token (classic or fine-grained)",
            "required": true
          },
          {
            "name": "defaultRepo",
            "type": "string",
            "description": "Default repository (owner/repo)",
            "required": false,
            "validation": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "pr-opened",
        "event": "github.pr.opened",
        "handler": "onPROpened",
        "priority": 10,
        "async": true
      },
      {
        "name": "pr-review-requested",
        "event": "github.pr.review_requested",
        "handler": "onPRReviewRequested",
        "priority": 10,
        "async": true
      },
      {
        "name": "issue-assigned",
        "event": "github.issue.assigned",
        "handler": "onIssueAssigned",
        "priority": 10,
        "async": true
      },
      {
        "name": "workflow-failed",
        "event": "github.workflow.failed",
        "handler": "onWorkflowFailed",
        "priority": 20,
        "async": true
      }
    ]
  },
  "dependencies": {
    "@octokit/rest": "^20.0.0",
    "@octokit/auth-token": "^4.0.0"
  },
  "engines": {
    "eidovara": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "categories": ["development", "github", "productivity", "notifications"],
  "screenshots": [],
  "icon": "icon.png",
  "minEidovaraVersion": "1.0.0",
  "platform": ["windows"],
  "languages": ["en", "es", "fr", "de"],
  "maturity": "beta",
  "publisher": "Soul Consciousness Studios",
  "license": "LicenseRef-Eidovara-Source-Available-1.0",
  "privacyPolicy": "https://github.com/ProjectSoulbyTmb/eidovara-github-tracker/blob/main/PRIVACY.md",
  "supportUrl": "https://github.com/ProjectSoulbyTmb/eidovara-github-tracker/issues",
  "contributionGuide": "https://github.com/ProjectSoulbyTmb/eidovara-github-tracker/blob/main/CONTRIBUTING.md",
  "changelog": "https://github.com/ProjectSoulbyTmb/eidovara-github-tracker/blob/main/CHANGELOG.md",
  "tags": ["github", "git", "tracker", "pr", "issues", "notifications", "developer"]
}
