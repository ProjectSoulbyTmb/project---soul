# Normalize line endings repo-wide. The canonical byte form is LF.
* text=auto eol=lf

# Windows scripts keep CRLF where tools require it
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.node binary
*.woff binary
*.woff2 binary
*.zip binary
*.bundle binary
