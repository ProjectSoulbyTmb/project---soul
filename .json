{
  "manifest_version": 1,
  "id": "com.soul.notion-sync",
  "name": "Notion Sync",
  "version": "1.0.0",
  "description": "Bidirectional sync between Eidovara memories and Notion pages",
  "author": "Soul Consciousness Studios",
  "license": "LicenseRef-Eidovara-Source-Available-1.0",
  "keywords": ["notion", "sync", "memory", "backup", "productivity"],
  "homepage": "https://github.com/ProjectSoulbyTmb/eidovara-notion-sync",
  "repository": "https://github.com/ProjectSoulbyTmb/eidovara-notion-sync",
  "funding": "https://github.com/sponsors/ProjectSoulbyTmb",
  "permissions": {
    "memory": true,
    "network": ["api.notion.com"],
    "filesystem": [],
    "shell": [],
    "notifications": true,
    "clipboard": "read",
    "idle": false,
    "power": false,
    "idleDetection": false
  },
  "entrypoints": {
    "main": "src/index.js",
    "commands": [
      {
        "id": "notion-sync.sync",
        "name": "Sync with Notion",
        "description": "Sync memories to/from Notion workspace",
        "shortcut": "Ctrl+Shift+N",
        "category": "sync",
        "action": "sync",
        "params": [
          {
            "name": "direction",
            "type": "select",
            "description": "Sync direction",
            "required": true,
            "default": "bidirectional",
            "options": [
              { "value": "push", "label": "Push to Notion" },
              { "value": "pull", "label": "Pull from Notion" },
              { "value": "bidirectional", "label": "Bidirectional" }
            ]
          },
          {
            "name": "databaseId",
            "type": "string",
            "description": "Notion database ID",
            "required": true,
            "validation": "^[a-f0-9]{32}$"
          }
        ]
      },
      {
        "id": "notion-sync.configure",
        "name": "Configure Notion Sync",
        "description": "Configure Notion API key and database",
        "shortcut": "Ctrl+Shift+Alt+N",
        "category": "settings",
        "action": "configure",
        "params": [
          {
            "name": "apiKey",
            "type": "string",
            "description": "Notion API integration token",
            "required": true
          },
          {
            "name": "databaseId",
            "type": "string",
            "description": "Notion database ID",
            "required": true,
            "validation": "^[a-f0-9]{32}$"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "memory-created",
        "event": "memory.created",
        "handler": "onMemoryCreated",
        "priority": 10,
        "async": true
      },
      {
        "name": "memory-updated",
        "event": "memory.updated",
        "handler": "onMemoryUpdated",
        "priority": 10,
        "async": true
      },
      {
        "name": "memory-deleted",
        "event": "memory.deleted",
        "handler": "onMemoryDeleted",
        "priority": 10,
        "async": true
      }
    ]
  },
  "dependencies": {
    "@notionhq/client": "^2.2.0"
  },
  "engines": {
    "eidovara": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "categories": ["productivity", "sync", "backup"],
  "screenshots": [],
  "icon": "icon.png",
  "minEidovaraVersion": "1.0.0",
  "platform": ["windows"],
  "languages": ["en", "es", "fr", "de"],
  "maturity": "beta",
  "publisher": "Soul Consciousness Studios",
  "license": "LicenseRef-Eidovara-Source-Available-1.0",
  "privacyPolicy": "https://github.com/ProjectSoulbyTmb/eidovara-notion-sync/blob/main/PRIVACY.md",
  "supportUrl": "https://github.com/ProjectSoulbyTmb/eidovara-notion-sync/issues",
  "contributionGuide": "https://github.com/ProjectSoulbyTmb/eidovara-notion-sync/blob/main/CONTRIBUTING.md",
  "changelog": "https://github.com/ProjectSoulbyTmb/eidovara-notion-sync/blob/main/CHANGELOG.md",
  "tags": ["notion", "sync", "memory", "backup", "productivity"]
}